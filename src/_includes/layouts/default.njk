<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {# SEO-Titel: Optimiert für die Suche in Stuttgart #}
    <title>{{ title or "Klavierstimmen Stuttgart | Klavierstimmung Stuttgart" }}</title>
    
    <meta name="description" content="{{ description or 'Professionelle Klavierstimmung und Reparatur in Stuttgart. Raphael Bauer – Ihr Experte für den perfekten Klang.' }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://piano-bauer.de{{ page.url }}">

    {# Open Graph für Social Media (WhatsApp, Facebook etc.) #}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title or 'Klavierstimmen Stuttgart | Raphael Bauer' }}">
    <meta property="og:description" content="Professioneller Service für Ihr Klavier in Stuttgart.">
    <meta property="og:image" content="https://piano-bauer.de/assets/images/Piano1.jpg">
  

    {# Google Fonts: Passend zu deiner index.css Konfiguration #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

    {# Pfad zum generierten CSS aus deinem Build-Prozess #}
    <link rel="stylesheet" href="/styles/index.css">

    {# Bestehende Zeile ergänzen/ersetzen #}
    <link rel="icon" href="/assets/images/Favicon.png" sizes="96x96">
    <link rel="apple-touch-icon" href="/assets/images/Favicon.png">

    {# Strukturierte Daten (JSON-LD): Damit Google Raphael als lokales Unternehmen in Stuttgart erkennt #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Raphael Bauer | Klavierstimmung & Service",
      "image": "https://piano-bauer.de/assets/images/logo.png",
      "url": "https://piano-bauer.de",
      "telephone": "+4915752684812",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Leonorenstraße 69",
        "addressLocality": "Stuttgart Degerloch",
        "postalCode": "70597",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.7758,
        "longitude": 9.1829
      },
      "description": "Professionelles Klavierstimmen und Wartung in der Region Stuttgart."
    }
    </script>

    {# Alpine.js Plugins #}
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  {# bg-cream und text-piano-dark nutzen deine Tailwind-Variablen #}
  <body class="bg-cream text-piano-dark font-sans antialiased">
    
    <main>
      {{ content | safe }}
    </main>

  <footer class="py-16 bg-leaf text-white text-sm border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="flex flex-col md:flex-row justify-between items-center mb-10 space-y-6 md:space-y-0 text-center md:text-left">
              <div>
                  <p class="font-display text-2xl text-white">Raphael Bauer</p>
                  <p class="text-white">Klavierstimmung & Service im Raum <span class="text-white font-bold">Stuttgart</span></p>
              </div>
              
              <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-center">
                  <a href="tel:+4915752684812" class="flex items-center hover:text-piano-dark transition-colors group">
                      <svg class="w-4 h-4 mr-2 text-white group-hover:text-piano-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                      +49 157 526 84812
                  </a>
                  <a href="mailto:stimmer.rbauer@gmail.com" class="flex items-center hover:text-piano-dark transition-colors group">
                      <svg class="w-4 h-4 mr-2 text-white group-hover:text-piano-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                      stimmer.rbauer@gmail.com
                  </a>
              </div>
          </div>

          <div class="pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 text-[11px] uppercase tracking-[0.1em] text-white">
              <div class="order-2 md:order-1">
                  &copy; 2026 Raphael Bauer <span class="mx-2 text-white">|</span> Klavierstimmer Stuttgart
              </div>
              
              <div class="flex space-x-8 order-1 md:order-2">
                  <a href="/impressum" class="hover:text-piano-dark transition-colors">Impressum</a>
                  <a href="/datenschutz" class="hover:text-piano-dark transition-colors">Datenschutz</a>
              </div>
          </div>
      </div>
  </footer>
    
  </body>
</html>